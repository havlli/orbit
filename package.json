{
  "name": "orbit-solar-odyssey",
  "version": "0.1.0",
  "description": "Interactive 3D solar system that replays real spacecraft missions from 1957 to 2021 using NASA JPL ephemerides.",
  "private": true,
  "license": "MIT",
  "author": "Jakub Havlíček",
  "homepage": "https://orbit.havlli.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/havlli/orbit.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/check-static-worker.mjs",
    "build:static": "ORBIT_STATIC_EXPORT=1 npm run build",
    "preview:static": "WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --config wrangler.static.jsonc --compatibility-date 2026-05-15",
    "deploy:cloudflare": "npm run build:static && WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --config wrangler.static.jsonc",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test:missions": "node --test tests/mission-flight.test.cjs tests/scene-texture.test.cjs tests/belt-rocks.test.cjs tests/frame-cadence.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.2.6",
    "shadcn": "4.22.1",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.156.0"
  },
  "type": "module"
}
